# Replace with your keys

# OpenRouter (LLM provider)
OPENROUTER_API_KEY=OPENROUTER
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

#Langsmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="LANGCHAIN"
LANGCHAIN_PROJECT=LANGCHAIN_PROJECT

# MongoDB
MONGODB_URI="MONGODB_URI"
DATABASE_NAME="conversations"
COLLECTION_NAME=COLLECTION_NAME

#AWS
AWS_ACCESS_KEY_ID=AWS
AWS_SECRET_ACCESS_KEY=AWS
BUCKET_NAME=BUCKET

# Auth0
AUTH0_DOMAIN=AUTH0_DOMAIN
AUTH0_SECRET=AUTH0_SECRET
AUTH0_API_AUDIENCE=AUTH0_API_AUDIENCE
AUTH0_ISSUER=AUTH0_ISSUER

# Optional configurations
FORCED_MODEL="deepseek/deepseek-v4-flash" # Modello LLM (OpenRouter slug). Default: deepseek/deepseek-v4-flash
# HISTORY_LIMIT=5

# Caching
# DeepSeek attiva il prefix-caching automaticamente lato provider; OpenRouter mantiene il cache
# caldo con sticky routing. Nessun parametro da configurare oltre al debug log.
CACHE_DEBUG_LOGGING=false            # Abilita logging dettagliato per cache hits/misses

# Monitoring Configuration
ENABLE_TOKEN_LOGGING=true            # Abilita logging token usage su MongoDB (collection: token_metrics)
